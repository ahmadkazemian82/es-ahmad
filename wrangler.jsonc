{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "es-ahmad",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a008b09d-c648-476c-9fa5-ca0663c6adf9","database_name": "es-ahmad" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "aa72a8d50e4c4b3c9c41674c840f66f7" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
